<?xml version="1.0" encoding="utf-8"?>
<!--
  FIX-02 companion (HIGH-005): Exclude all sensitive app data from
  Cloud Backup and device-to-device transfer.
  This works alongside android:allowBackup="false" in AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- DataStore (previously stored GitHub PAT in plaintext) -->
        <exclude domain="sharedpref" path="innogen_prefs.xml" />
        <!-- Encrypted key stores (while encrypted, still best excluded) -->
        <exclude domain="sharedpref" path="innogen_secure_github.xml" />
        <exclude domain="sharedpref" path="innogen_db_key_store.xml" />
        <!-- Room database files -->
        <exclude domain="database" path="innogen_db" />
        <exclude domain="database" path="innogen_db-shm" />
        <exclude domain="database" path="innogen_db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="innogen_prefs.xml" />
        <exclude domain="sharedpref" path="innogen_secure_github.xml" />
        <exclude domain="sharedpref" path="innogen_db_key_store.xml" />
        <exclude domain="database" path="innogen_db" />
        <exclude domain="database" path="innogen_db-shm" />
        <exclude domain="database" path="innogen_db-wal" />
    </device-transfer>
</data-extraction-rules>

